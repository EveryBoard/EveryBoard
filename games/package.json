{
  "name": "@everyboard/games",
  "version": "1.0.0",
  "description": "EveryBoard's Games",
  "private": "true",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "TS_NODE_PROJECT=tsconfig.test.json nyc -x '**/*.spec.ts' --reporter=lcov --reporter=text --reporter=text-summary npx jasmine --config=jasmine.json",
    "coverage": "nyc --branches 100 --lines 100 --statements 100 --functions 100 check-coverage"
  },
  "devDependencies": {
    "@angular/localize": "^20.3.18",
    "@types/jasmine": "^6.0.0",
    "jasmine": "^6.2.0",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2"
  }
}
