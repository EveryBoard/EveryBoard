{
    "spec_dir": "src",
    "jsLoader": "require",
    "spec_files": ["**/*.spec.ts"],
    "requires": [
        "ts-node/register/type-check",
        "tsconfig-paths/register"
    ],
    "helpers": ["browser-globals-setup.ts", "ci-setup.ts"],
