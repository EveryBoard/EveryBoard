{
  "name": "EveryBoard",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=debug",
    "start:emulator": "bash ./scripts/start-in-emulator.sh",
    "build": "ng build --configuration=production",
    "build:netlify": "ng build --configuration=test,debug",
    "build:dev": "ng build --configuration=production,dev",
    "build:test": "ng build --configuration=test",
    "test": "bash ./scripts/test.sh",
    "test:ci": "bash ./scripts/test.sh --watch=false --browsers=ChromeHeadlessCustom --configuration=ci",
    "libtest": "cd lib && npm test",
    "libtest:ci": "cd lib && npm ci && npm test && npm run coverage",
    "lint": "eslint --ext ts ./ --quiet",
    "e2e": "python ./e2e/launch.py"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/common": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@creativebulma/bulma-tooltip": "^1.2.0",
    "@everyboard/lib": "file:lib",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "async-mutex": "^0.5.0",
    "bulma": "1.0.4",
    "bulma-toast": "^2.4.4",
    "bulmaswatch": "^0.8.1",
    "core-js": "^3.39.0",
    "firebase": "^12.11.0",
    "fuse.js": "^7.3.0",
    "rxjs": "^7.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.21",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "^20.3.21",
    "@angular/compiler": "^20.3.18",
    "@angular/compiler-cli": "^20.3.18",
    "@angular/localize": "^20.3.18",
    "@stylistic/eslint-plugin-ts": "^2.13.0",
    "@types/jasmine": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "angular-cli-ghpages": "^3.0.2",
    "angular-eslint": "^20.0.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.0.0",
    "firebase-tools": "^15.11.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-time-stats-reporter": "^0.1.0",
    "netlify-plugin-chromium": "^1.1.4",
    "nyc": "^18.0.0",
    "sass": "^1.81.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
