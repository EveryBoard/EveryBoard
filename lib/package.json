{
  "name": "@everyboard/lib",
  "version": "1.0.0",
  "description": "EveryBoard's library",
  "private": "true",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/esm/testing.js",
      "require": "./dist/testing.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && tsc --project tsconfig.esm.json",
    "watch": "tsc --watch",
    "test": "nyc -x '**/*.spec.ts' --reporter=lcov --reporter=text --reporter=text-summary npx jasmine --config=jasmine.json",
    "coverage": "nyc --branches 100 --lines 100 --statements 100 --functions 100 check-coverage"
  },
  "devDependencies": {
    "@types/jasmine": "^6.0.0",
    "jasmine": "^6.1.0",
    "nyc": "^18.0.0",
    "ts-node": "^10.9.2"
  }
}
