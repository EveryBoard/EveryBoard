FROM node:24-trixie-slim AS frontend

ENV NG_CLI_ANALYTICS=false

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY lib/package.json lib/package-lock.json ./lib/
COPY games/package.json games/package-lock.json ./games/
RUN npm ci \
    && npm --prefix lib ci \
    && npm --prefix games ci

COPY . .
RUN cp src/app/firebaseConfig.ts.dummy src/app/firebaseConfig.ts

FROM frontend AS translations-ci

ENV PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
    && python3 -m venv /opt/venv \
    && pip install --no-cache-dir --requirement scripts/requirements.txt \
    && rm -rf /var/lib/apt/lists/*

FROM translations-ci AS ci

ENV CHROME_BIN=/usr/bin/chromium

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        chromium \
        openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*
RUN npx firebase setup:emulators:firestore
