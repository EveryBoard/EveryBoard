FROM node:24-trixie-slim AS frontend

ENV NG_CLI_ANALYTICS=false

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY lib/package.json lib/package-lock.json ./lib/
COPY games/package.json games/package-lock.json ./games/
RUN npm ci \
    && npm --prefix lib ci \
    && npm --prefix games ci

COPY . .
RUN cp src/app/firebaseConfig.ts.dummy src/app/firebaseConfig.ts

FROM frontend AS python-ci

ENV PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
    && python3 -m venv /opt/venv \
    && rm -rf /var/lib/apt/lists/*

FROM python-ci AS translations-ci

RUN pip install --no-cache-dir --requirement scripts/requirements-translations.txt

FROM python-ci AS ci

ENV CHROME_BIN=/usr/bin/chromium

RUN pip install --no-cache-dir --requirement scripts/requirements.txt \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        chromium \
        openjdk-21-jre-headless \
    && rm -rf /var/lib/apt/lists/*
RUN npx firebase setup:emulators:firestore

FROM golang:1.26-trixie AS e2e-backend-build

ENV GOTOOLCHAIN=local

WORKDIR /workspace

COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download

COPY backend ./backend
RUN cd backend && go build -o backend cmd/backend/main.go

FROM ci AS e2e

RUN apt-get update \
    && apt-get install --yes --no-install-recommends chromium-driver \
    && rm -rf /var/lib/apt/lists/*

COPY --from=e2e-backend-build /workspace/backend/backend ./backend/backend

FROM alpine:3.22 AS images-ci

WORKDIR /workspace

COPY scripts/check-images.sh ./scripts/check-images.sh
COPY src/app/components/normal-component/pick-game/pick-game.component.ts \
    ./src/app/components/normal-component/pick-game/pick-game.component.ts
COPY src/assets/images/dark ./src/assets/images/dark
COPY src/assets/images/light ./src/assets/images/light
